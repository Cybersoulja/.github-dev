# Copy this file to .env and fill in your real values. .env is gitignored —
# never commit your capability token.

# Your Craft Connect API link (capability URL). This URL embeds an access
# token to your Craft space — treat it as a secret, keep it only in your
# local .env (gitignored), and never commit a real value here.
CRAFT_API_URL=https://connect.craft.do/links/REPLACE_WITH_YOUR_LINK/api/v1

# Port the local Express server listens on.
PORT=3000

# Interface the server binds to. Defaults to loopback-only (127.0.0.1) —
# this proxy forwards requests using your CRAFT_API_URL token with no auth
# of its own, so only change this if you understand that anyone who can
# reach this host on the network would then be able to use your token too.
HOST=127.0.0.1

# When true, endpoints return canned fixtures from local-api/mocks/ instead
# of calling CRAFT_API_URL. Useful for offline development or demos.
USE_MOCKS=false

# Comma-separated list of origins allowed to call this server cross-origin
# (e.g. the Craft Connect API Studio's web origin, if you use its Local
# Proxy Switcher). Leave empty (the default) to disable cross-origin
# access entirely — with no CRAFT_API_URL auth of its own, an open CORS
# policy would let any webpage you have open in a browser read your
# Craft documents through this proxy while it's running.
ALLOWED_ORIGINS=
